{
  // Cloudflare Workers の設定。バインディング(D1/R2)はリソース作成後にコメントを外す。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regen",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // ↓ `wrangler d1 create regen-db` 実行後、database_id を貼ってコメントを外す
  // ,"d1_databases": [
  //   { "binding": "DB", "database_name": "regen-db", "database_id": "TODO" }
  // ]
  // ↓ `wrangler r2 bucket create regen-bundles` 実行後にコメントを外す
  // ,"r2_buckets": [
  //   { "binding": "BUNDLES", "bucket_name": "regen-bundles" }
  // ]
}
