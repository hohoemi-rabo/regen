{
  // Cloudflare Workers の設定。バインディング名は要件§7に合わせて DB / BUNDLES。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regen",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "regen-db",
      "database_id": "98dc019f-ee56-4e89-9ff5-4ad0062cf0dd",
      // drizzle-kit の出力先。既定は apps/web/migrations なので明示する
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "regen-bundles"
    },
    {
      // OpenNextがSSG/ISRページを配信するためのキャッシュ。
      // 同じバケットを incremental-cache/ 配下に間借りする(診断バンドルは bundles/ 配下)
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "regen-bundles"
    }
  ],
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache"
  },
  // POST /api/scenarios は認証のない公開の書き込み口(要件§7「不要(レート制限あり)」)。
  // IPあたり10件/60秒。IPは制限キーに使うだけで保存しない(F-6-3 個人情報を収集しない)
  "ratelimits": [
    {
      "name": "SCENARIO_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // 管理画面のログイン(F-7-1)。総当たりを鈍らせる。IPあたり5回/60秒。
      // better-auth 内蔵のレート制限は既定でメモリ保持 = Workersではアイソレートごとに
      // なるため、シナリオ保存と同じ Cloudflare 側の仕組みに揃える
      "name": "ADMIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
